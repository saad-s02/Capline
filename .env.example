# Capline environment variables. Copy to `.env` (gitignored) and fill in.
# VITE_* vars are exposed to the browser by Vite; never put secrets in them.

# --- Frontend (browser) ---
# Public URL of the PMTiles archive on Cloudflare R2 (or any byte-range host).
# Used by the map as: pmtiles://$VITE_PMTILES_URL
VITE_PMTILES_URL=https://pub-xxxx.r2.dev/capline.pmtiles

# Supabase project (anon key is public/browser-safe by design with RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared secret gating the minimal /review page in the MVP (not real auth; a
# non-goal to build accounts yet). Keep this out of the client bundle in
# production by moving review behind a server route before any real launch.
VITE_REVIEW_SECRET=change-me

# --- Pipeline / build (server-side, NOT exposed to the browser) ---
# Cloudflare R2 S3-compatible endpoint and bucket for tile uploads.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=capline-tiles
# Public read URL of the uploaded archive (same value as VITE_PMTILES_URL).
PMTILES_URL=https://pub-xxxx.r2.dev/capline.pmtiles

# Postgres connection string for the seed pipeline (Supabase or local PostGIS).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Descriptive User-Agent required by SEC EDGAR and polite for Nominatim/Wikidata.
PIPELINE_USER_AGENT=Capline/0.1 (capline.ca; you@example.com)
